# Alibaba Cloud OSS release credentials.
# Copy this file to .env and fill the two credential values locally.
# Never commit or share the completed .env file.

CLAUDE_LANE_OSS_ACCESS_KEY_ID=
CLAUDE_LANE_OSS_ACCESS_KEY_SECRET=

# Non-secret bucket configuration.
CLAUDE_LANE_OSS_BUCKET=your-private-release-bucket
CLAUDE_LANE_OSS_REGION=oss-cn-beijing
CLAUDE_LANE_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Optional independent domestic backup. Leave empty until provisioned.
CLAUDE_LANE_BACKUP_OSS_ACCESS_KEY_ID=
CLAUDE_LANE_BACKUP_OSS_ACCESS_KEY_SECRET=
CLAUDE_LANE_BACKUP_OSS_BUCKET=
CLAUDE_LANE_BACKUP_OSS_REGION=
CLAUDE_LANE_BACKUP_OSS_ENDPOINT=
